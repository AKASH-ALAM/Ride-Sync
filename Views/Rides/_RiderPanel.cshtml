@model RiderPanelVm
@{
    var a = Model.Active;
    int step = a?.Status switch { RideStatus.Pending => 0, RideStatus.Accepted => 1, RideStatus.DriverArrived => 2, RideStatus.InProgress => 3, _ => 0 };
}
<div id="rideData" hidden data-ride='@RideSync.Web.Controllers.RidesController.RideJson(a)'></div>
@if (a is null)
{
    @if (Model.Unrated is { } u)
    {
        <div class="p-3 rounded-4 bg-light mb-4">
            <div class="fw-bold mb-1">How was your ride with @u.Driver?.Name?</div>
            <div class="muted small mb-2">@u.Pickup → @u.Drop · ৳@u.Fare.ToString("0")</div>
            <form asp-action="Rate" method="post" data-ajax class="stars"><input type="hidden" name="id" value="@u.Id" />
                @for (var s = 1; s <= 5; s++) { <button name="stars" value="@s" title="@s star@(s > 1 ? "s" : "")">★</button> }
            </form>
            <a class="small fw-semibold" asp-action="Receipt" asp-route-id="@u.Id">View receipt</a>
        </div>
    }
    <h3>Get a ride</h3>
    <form id="bookForm" asp-action="RequestRide" method="post" data-ajax>
        <input type="hidden" name="idempotencyKey" value="@Model.IdempotencyKey" />
        <input type="hidden" name="plat" /><input type="hidden" name="plng" /><input type="hidden" name="dlat" /><input type="hidden" name="dlng" />
        <input type="hidden" name="vehicle" value="car" />
        <div class="field"><span class="ico"></span><input id="pickup" name="pickup" class="form-control" placeholder="Pickup location" autocomplete="off" /><button type="button" class="caret" tabindex="-1" aria-label="Show places">▾</button><div class="suggest" hidden></div></div>
        <div class="field"><span class="ico sq"></span><input id="drop" name="drop" class="form-control" placeholder="Where to?" autocomplete="off" /><button type="button" class="caret" tabindex="-1" aria-label="Show places">▾</button><div class="suggest" hidden></div></div>
        <button type="button" id="locate" class="btn btn-light btn-sm mb-3">📍 Use my location</button>
        <p id="hint" class="muted small">Search an address, or tap the map to set pickup then drop-off.</p>
        <div id="estimate" hidden>
            <div id="surgeNote"></div>
            <div id="options"></div>
            <div class="divider"></div>
            <select name="payment" class="form-select mb-3">
                <option value="cash">💵 Cash</option>
                <option value="wallet">👛 Wallet (৳@Model.Balance.ToString("N0"))</option>
            </select>
            <button class="btn btn-dark btn-lg w-100" id="confirm">Request Car</button>
        </div>
    </form>
}
else
{
    var v = Pricing.Vehicles[a.VehicleType];
    <div class="steps"><i class="@(step >= 0 ? "on" : "")"></i><i class="@(step >= 1 ? "on" : "")"></i><i class="@(step >= 2 ? "on" : "")"></i><i class="@(step >= 3 ? "on" : "")"></i></div>
    @if (a.Status == RideStatus.Pending)
    {
        <div class="searching"><div class="radar"></div><h3 class="mb-1">Finding your driver…</h3><p class="muted">Nearby drivers have been alerted. This page updates the moment someone accepts.</p></div>
    }
    else
    {
        <h3>@(a.Status switch { RideStatus.Accepted => "Your driver is on the way", RideStatus.DriverArrived => "Your driver has arrived", _ => "Enjoy your ride" })</h3>
        <div id="eta" class="muted mb-3" data-status="@a.Status"></div>
        <div class="driver-card mb-3">
            <div class="ava">@a.Driver?.Name.Substring(0, 1).ToUpper()</div>
            <div class="flex-grow-1"><div class="fw-bold" style="font-size:1.15rem">@a.Driver?.Name</div>
                <div class="muted small">@(a.Driver?.AvgRating is { } r ? $"★ {r:0.0} ({a.Driver.RatingCount})" : "★ New driver")</div></div>
            <div class="text-end"><div class="plate">@a.Driver?.VehicleNumber</div><div class="muted small mt-1">@v.Icon @v.Name</div></div>
        </div>
    }
    <div class="p-3 rounded-4 bg-light mb-3">
        <div class="mb-2 d-flex gap-2"><span class="dot-a"></span><span>@a.Pickup</span></div>
        <div class="d-flex gap-2"><span class="dot-b"></span><span>@a.Drop</span></div>
    </div>
    <div class="d-flex justify-content-between mb-3"><span class="muted">@v.Icon @v.Name · @a.DistanceKm.ToString("0.0") km @(a.Surge > 1 ? $"· surge ×{a.Surge:0.0}" : "")</span>
        <span class="fw-bold">৳@a.Fare.ToString("0") <span class="chip">@a.PaymentMethod</span></span></div>
    @if (a.Status is RideStatus.Pending or RideStatus.Accepted or RideStatus.DriverArrived)
    {
        <form asp-action="Status" method="post" data-ajax><input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="status" value="cancelled" />
            <button class="btn btn-light w-100">Cancel ride</button></form>
    }
}
